NODE_ENV=production
PORT=36628
# Postgres connection string (use sslmode=require on managed databases).
DATABASE_URL=postgres://user:password@host:5432/achaki
# Redis/Valkey connection string. Use rediss:// when TLS is required.
REDIS_URL=redis://localhost:6379
# Comma-separated origins of the admin and app front-ends.
CORS_ORIGINS=https://admin.example.com,https://app.example.com
SESSION_TTL_HOURS=12
# true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=true

# Chave-mestra de infraestrutura (mínimo 32 caracteres). As credenciais das lojas
# são cadastradas pelo Admin e criptografadas no banco com esta chave.
SETTINGS_ENCRYPTION_KEY=replace-with-a-unique-random-secret-at-least-32-characters
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.com.br/graphql
SHOPEE_AFFILIATE_TIMEOUT_MS=15000
